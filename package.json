{
  "name": "atom-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Atom Studio — an AI agent that turns a prompt into a runnable web app.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
